# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=4001
PROJECT_NAME=Lodhaura Village Portal
PAGINATION_LIMIT=10

# MongoDB Atlas
DB_NAME=lodhaura
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lodhaura?appName=Cluster0

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (for password reset emails)
FRONTEND_URL=http://localhost:3000

# Email queue
NUMBER_OF_EMAILS=12
INTERVAL_BETWEEN=60

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
